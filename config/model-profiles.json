{
  "schema_version": "1.0",
  "description": "Built-in Raiker model profile registry. Running the global raiker command opens the TUI, and the TUI uses these profiles for local and policy-controlled providers. The native default backend is the llama.cpp server.",
  "profiles": [
    {
      "profile_id": "mock-test",
      "provider": "mock",
      "model": "mock-deterministic",
      "build_phase": "phase_1",
      "default_state": "enabled_for_tests",
      "tui_launch_action": "/launch --provider mock --model mock-deterministic",
      "local_only": true,
      "requires_network": false,
      "supports_streaming": false,
      "supports_tool_calls": true,
      "tool_call_mode": "json_schema"
    },
    {
      "profile_id": "llama-cpp-local-gguf",
      "provider": "llama.cpp",
      "model": "local-gguf",
      "build_phase": "phase_2",
      "default_state": "native_default_when_server_reachable",
      "tui_launch_action": "/launch --provider llama.cpp --model local-gguf",
      "is_native_default": true,
      "endpoint": "http://127.0.0.1:8080",
      "served_model_name": "local-gguf",
      "n_ctx": 8192,
      "temperature": 0.2,
      "max_tokens": 1024,
      "timeout_seconds": 120,
      "tool_call_protocol": "openai",
      "local_only": true,
      "requires_network": false,
      "supports_streaming": true,
      "supports_tool_calls": true,
      "tool_call_mode": "openai_compatible",
      "notes": "Run `llama-server -m <model.gguf> --port 8080 --jinja`; Raiker uses it automatically when reachable."
    },
    {
      "profile_id": "lm-studio-local",
      "provider": "lm-studio",
      "model": "<model>",
      "build_phase": "phase_2",
      "default_state": "disabled_until_provider_detected",
      "tui_launch_action": "/launch --provider lm-studio --model <model>",
      "local_only": true,
      "requires_network": false,
      "supports_streaming": true,
      "supports_tool_calls": true,
      "tool_call_mode": "openai_compatible"
    },
    {
      "profile_id": "openai-compatible-local",
      "provider": "openai-compatible",
      "model": "<model>",
      "build_phase": "phase_2",
      "default_state": "disabled_until_endpoint_configured",
      "tui_launch_action": "/launch --provider openai-compatible --endpoint <endpoint> --model <model>",
      "local_only": false,
      "requires_network": false,
      "supports_streaming": true,
      "supports_tool_calls": true,
      "tool_call_mode": "native_or_json_schema"
    },
    {
      "profile_id": "vllm-gpu-server",
      "provider": "vllm",
      "model": "<served-model>",
      "build_phase": "phase_5",
      "default_state": "disabled_until_high_throughput_serving_approved",
      "tui_launch_action": "/launch --provider vllm --endpoint <endpoint> --model <served-model>",
      "endpoint": "http://127.0.0.1:8000",
      "local_only": false,
      "requires_network": true,
      "supports_streaming": true,
      "supports_tool_calls": true,
      "tool_call_mode": "openai_compatible",
      "notes": "Later high-throughput GPU serving for a home lab or VPS. Not wired; enabled only after the llama.cpp native path is solid and egress/budget policy is configured."
    },
    {
      "profile_id": "hosted-policy-controlled",
      "provider": "hosted",
      "model": "<provider-model>",
      "build_phase": "phase_3_to_phase_5",
      "default_state": "disabled_until_policy_approved",
      "tui_launch_action": "/launch --provider <provider> --model <model>",
      "local_only": false,
      "requires_network": true,
      "supports_streaming": true,
      "supports_tool_calls": true,
      "tool_call_mode": "provider_specific",
      "requires_egress_policy": true,
      "requires_budget_policy": true
    }
  ]
}
