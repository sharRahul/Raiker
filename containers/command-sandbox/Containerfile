# Re-pinned 2026-10-11: the earlier digest was no longer served by the
# registry, so the image could not be rebuilt (BUG-329's scan found it).
# scripts/scan_images.py scans this exact image on every change.
FROM python:3.13.16-slim@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f

RUN groupadd --gid 65532 raiker \
 && useradd --uid 65532 --gid 65532 --no-create-home --home-dir /home/raiker raiker \
 && mkdir -p /home/raiker/.cache /workspace \
 && chown -R 65532:65532 /home/raiker /workspace

COPY --chown=65532:65532 raiker-command-supervisor /usr/local/bin/raiker-command-supervisor
RUN chmod 0555 /usr/local/bin/raiker-command-supervisor

USER 65532:65532
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/raiker-command-supervisor"]
