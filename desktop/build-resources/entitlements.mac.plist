<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SPDX-License-Identifier: Apache-2.0
  Hardened-runtime entitlements for the Raiker app and the frozen host inside it.
  Electron's V8 needs JIT memory; the frozen Python host loads its own extension
  modules, which library validation would otherwise refuse. Microphone access is
  declared because voice input asks for it; the window still grants media to the
  Raiker origin only, and macOS still asks the owner.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
