{
  "name": "raiker-desktop",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "description": "Raiker's desktop window: an Electron shell around the local Raiker host.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "start": "npm run build && electron .",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && npx --yes electron-builder@26.17.0 --config electron-builder.yml"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "22.20.1",
    "electron": "44.5.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "author": "Raiker contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharRahul/Raiker.git"
  },
  "homepage": "https://github.com/sharRahul/Raiker"
}
