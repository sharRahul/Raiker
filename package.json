{
  "name": "raiker-root",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Raiker's local-first personal AI agent. Root scripts delegate to the governed single-owner web app in web/ and its desktop window in desktop/.",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "check": "npm --prefix web run check",
    "lint": "npm --prefix web run lint",
    "test": "npm --prefix web run test",
    "test:e2e:mocked": "npm --prefix web run test:e2e:mocked",
    "test:e2e:live": "npm --prefix web run test:e2e:live",
    "desktop:build": "npm --prefix desktop run build",
    "desktop:start": "npm --prefix desktop run start",
    "desktop:test": "npm --prefix desktop run test"
  }
}
