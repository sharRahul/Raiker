            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemorySource"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
