    "/api/work-threads": {
      "get": {
        "description": "What this owner is working on, across chats, projects and routines (C18).\n\nChat search answers *\"where did I say that\"*. This answers *\"what am I\nworking on\"*, which is a different question and had no reader: it spans the\nconversations the owner started **and** the threads a routine is advancing\non its own, names the project each sits in, and says which are blocked on a\ndecision.\n\nOwner-scoped exactly like `/api/sessions`, and read-only. It joins rows that\nalready existed rather than recording anything new.",
        "operationId": "list_work_threads_api_work_threads_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WorkThreadView"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Work Threads"
      }
    },
    "/api/work-threads/page": {
      "get": {
        "description": "The work index: one filtered, faceted, bounded page of it (NEW-THREAD-01).\n\nBeside `/api/work-threads`, which stays the unfiltered first page for\ncallers that want exactly that. This one exists because Threads was doing\nthe index's job in a browser: it read one page of a hundred rows and derived\nits Project choices from what arrived, so a project whose newest thread fell\noutside that page was not offered as a filter at all — indistinguishable, on\nscreen, from a project with nothing in it.\n\nFilters are applied first, facets are computed over everything that matched\nwith their own filter lifted, and only then is the answer paged. Owner-scoped\nexactly like the listing beside it, and read-only.\n\n``archived`` is a scope rather than a filter (BUG-303): the two sets do not\noverlap and every other filter applies within whichever one is read. Both\ncounts come back either way, so a thread archived from this page can be\nfound and restored from this page.",
        "operationId": "work_thread_page_api_work_threads_page_get",
        "parameters": [
          {
            "in": "query",
            "name": "project_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Project Id"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "query",
            "required": false,
            "schema": {
              "default": "",
              "title": "Query",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "archived",
            "required": false,
            "schema": {
              "default": false,
              "title": "Archived",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkThreadPage"
                }
              }
            },
            "description": "Successful Response"
