        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelDecisionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Model Decision"
      }
    },
    "/api/model-decisions": {
      "get": {
        "description": "Every surface's decision in one read.\n\nOverview answers \"what powers Chat, Build and Design\" as its\nfirst fact, which is five of the read above. Asking five times is five\nround trips and — worse — five separately-timed answers, so the page could\nrender a Chat row from before a change and a Build row from after it. One\nservice instance, so every surface is judged against the same readiness\ncache.",
